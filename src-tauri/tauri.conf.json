{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Manager",
  "version": "0.1.0",
  "identifier": "com.filemanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "File Manager — 文件整理",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFRjFBMkZFRThDQ0U0QzIKUldUQzVNem8vcUx4amtabEVINWNjd0lEVjZYV3hOTUMyUUVWTlRrZEJDTnpWbCt0TUo2VURaZFEK",
      "endpoints": [
        "https://github.com/crazyjackab/cp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
